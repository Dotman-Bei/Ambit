# Ambit environment. Copy to .env and fill in.
#
# §0.5: this file carries EMPTY PLACEHOLDERS ONLY. No token, no key share, no private key, ever.
# A pre-commit hook scans for DYNAMIC_, PRIVATE_KEY, keyShare and -----BEGIN and refuses the commit.
#
# §6 FAIL-CLOSED: only the exact strings `1` and `true` enable anything. A typo, an empty string,
# `false`, `yes`, `on` or unset all mean off. This is stricter than the usual "truthy env var"
# helper on purpose — a flag that guesses at intent is a flag that can be switched on by accident,
# and this one gates whether money can move.

# ---------------------------------------------------------------- Dynamic (R1, R2)
# From the Dynamic dashboard. The environment id is not a secret; the API key is.
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_KEY=

# Optional overrides. Leave empty for Dynamic's defaults.
DYNAMIC_BASE_API_URL=
DYNAMIC_MPC_RELAY_URL=

# ---------------------------------------------------------------- delegation webhook
# Verified on every webhook call BEFORE the body is parsed (§18).
DYNAMIC_WEBHOOK_SECRET=

# The RSA private key that decrypts delegated credentials. Generate with:
#   openssl genrsa -out internal/delegation_private.pem 4096
#   openssl rsa -in internal/delegation_private.pem -pubout -out internal/delegation_public.pem
# Register the PUBLIC half in the Dynamic dashboard. The private half goes here and never in git.
# Paste the PEM with literal \n escapes, or mount it as a file and read it in.
DELEGATION_PRIVATE_KEY=

# Credentials are re-encrypted at rest with AES-256-GCM (§18). 32 bytes, base64:
#   openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------- execution (§20)
# The environment-flag half of the emergency controls. Needs a deploy to change.
# The database pauses in /admin/pause take effect immediately, without one.
EXECUTION_ENABLED=0

# ---------------------------------------------------------------- x402 rail (§12)
# The facilitator that verifies and settles payment authorizations.
# Without it the seller route REFUSES rather than accepting a payment on trust.
X402_FACILITATOR_URL=

# ---------------------------------------------------------------- seller (§12.4)
# The PROJECT_OPERATED seller route. Labelled as such everywhere it appears.
SELLER_PAY_TO=
SELLER_NETWORK=base-sepolia
SELLER_ASSET_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
SELLER_PRICE_ATOMIC=50000
SELLER_DOMAIN_NAME=USDC
SELLER_DOMAIN_VERSION=2

# ---------------------------------------------------------------- service
PORT=4020
SELLER_PORT=4021
ALLOWED_ORIGINS=http://localhost:3000
AMBIT_SELLER_BASE_URL=http://127.0.0.1:4021/
NEXT_PUBLIC_AMBIT_API=http://127.0.0.1:4020
